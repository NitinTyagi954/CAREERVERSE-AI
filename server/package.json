{
  "name": "careerverse-server",
  "version": "1.0.0",
  "description": "CareerVerse AI Backend - MERN Stack Job & Freelance Discovery Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "seed:jobs": "node scripts/seed-jobs.js",
    "seed:gigs": "node scripts/seed-gigs.js",
    "seed": "npm run seed:jobs && npm run seed:gigs"
  },
  "keywords": ["mern", "job-matching", "resume-parsing", "freelance", "ai"],
  "author": "CareerVerse Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.0.3",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.6.0",
    "uuid": "^9.0.1",
    "joi": "^17.11.0",
    "cors": "^2.8.5",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "mongodb-memory-server": "^9.1.1",
    "eslint": "^8.55.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "services/**/*.js",
      "controllers/**/*.js",
      "!**/node_modules/**"
    ]
  }
}

